/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dnd-db-rest",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
    "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dnd-db",
          "database_id": "5b91e506-75c8-42e6-97f0-61317e69ae8a"
        }
    ],
    "secrets_store_secrets": [
        {
            "store_id": "054dccb20f304a36b0f041e9e560c5aa",
            "binding": "SECRET",
            "secret_name": "dnd-db-rest-secret"
        }
    ],
	"routes": [
    {
      "pattern": "dnd-service.omnomnom.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "pipelines": [
    {
      "pipeline": "8765aea44a85447ca196ffe6544f0453",
      "binding": "LOGPUSH_WORKERS_TRACE_EVENTS_STRATUS_STREAM"
    }
  ]
}
